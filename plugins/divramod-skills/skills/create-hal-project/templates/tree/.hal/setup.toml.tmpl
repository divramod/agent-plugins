# What `hal2-cli-git worktree merge-from-main` (/mfm) sets up in every worktree after its merge: advisory, a program
# that is not installed is skipped and a failing task reported, never the merge's failure.

# The `commit-msg` hook (hal2-cli-records' Commit Message kind): written once into the hooks folder every worktree
# shares; a no-op where hal2-cli-records is missing.
[[setup]]
name = "commit-msg hook"
command = ["hal2-cli-records", "commit-msg", "--install"]

# The `pre-push` hook: a shim in the same shared hooks folder that runs the pushing worktree's own
# code/bash/scripts/pre-push/main.sh (the gate's lint jobs for what the push changes); another tool's hook stays.
[[setup]]
name = "pre-push hook"
command = ["bash", "code/bash/scripts/pre-push/main.sh", "--install"]
