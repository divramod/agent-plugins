#!/usr/bin/env bats
# shellcheck disable=SC2154,SC2030,SC2031
# Tests of the pre-push unit: a scratch repository holds a copy of the unit and a fake gate that records the jobs
# it is asked to run (FAIL_JOB makes one red); no real shellcheck or gitleaks runs.

ZERO=0000000000000000000000000000000000000000

setup() {
  repo="$BATS_TEST_TMPDIR/repo"
  pp="$repo/code/bash/scripts/pre-push"
  CALLS="$BATS_TEST_TMPDIR/calls"
  export CALLS
  unset PRE_PUSH PRE_PUSH_BASE PRE_PUSH_GATE GIT_DIR
  mkdir -p "$pp" "$repo/code/bash/scripts/gate"
  cp "$BATS_TEST_DIRNAME/main.sh" "$pp/"
  printf 'bash-lint\n# a comment\n\npython-lint\nsecrets-scan\n' >"$repo/code/bash/scripts/gate/lint-jobs.txt"
  cat >"$repo/code/bash/scripts/gate/main.sh" <<'FAKE'
#!/usr/bin/env bash
echo "gate $* base=${GATE_BASE:+set}" >>"$CALLS"
[[ "${FAIL_JOB:-}" != "$1" ]] || { echo "boom from $1"; exit 1; }
FAKE
  : >"$CALLS"
  git -C "$repo" init -q -b main
  git_commit "init"
}

git_commit() {
  git -C "$repo" add -A
  git -C "$repo" -c user.email=t@t -c user.name=t -c commit.gpgsign=false commit -q --allow-empty -m "$1"
}

# change_on_branch <file>...: a branch `topic` off main that adds the files.
change_on_branch() {
  local file
  git -C "$repo" checkout -q -b topic
  for file in "$@"; do
    mkdir -p "$repo/$(dirname "$file")"
    echo x >"$repo/$file"
  done
  git_commit "topic"
}

# push_lines <local ref> <sha> <remote ref>: git's stdin line for the hook.
push_lines() { echo "$1 $2 $3 $ZERO"; }

head_sha() { git -C "$repo" rev-parse HEAD; }

@test "install writes an executable hook shim, then says it is current" {
  run bash "$pp/main.sh" --install
  [ "$status" -eq 0 ]
  [[ "$output" == "wrote "* ]]
  [ -x "$repo/.git/hooks/pre-push" ]
  run bash "$pp/main.sh" --install
  [ "$status" -eq 0 ]
  [[ "$output" == *"is current" ]]
}

@test "install refuses another tool's hook and leaves it as it was" {
  mkdir -p "$repo/.git/hooks"
  printf '#!/bin/sh\necho foreign\n' >"$repo/.git/hooks/pre-push"
  run bash "$pp/main.sh" --install
  [ "$status" -eq 1 ]
  [[ "$output" == *"another tool's hook"* ]]
  [ "$(cat "$repo/.git/hooks/pre-push")" = $'#!/bin/sh\necho foreign' ]
}

@test "install in a linked worktree writes the shared hooks folder" {
  git -C "$repo" worktree add -q "$BATS_TEST_TMPDIR/wt" -b wt
  run bash "$BATS_TEST_TMPDIR/wt/code/bash/scripts/pre-push/main.sh" --install
  [ "$status" -eq 0 ]
  [ -x "$repo/.git/hooks/pre-push" ]
}

@test "a bash change runs bash-lint and secrets-scan, not python-lint" {
  change_on_branch code/bash/scripts/x/main.sh
  run bash "$pp/main.sh" origin url <<<"$(push_lines refs/heads/topic "$(head_sha)" refs/heads/topic)"
  [ "$status" -eq 0 ]
  [[ "$output" == *"bash-lint ok"* ]]
  [[ "$output" == *"secrets-scan ok"* ]]
  [[ "$output" != *"python-lint"* ]]
  grep -qx "gate bash-lint --changed base=set" "$CALLS"
}

@test "a python change runs python-lint and secrets-scan" {
  change_on_branch code/python/scripts/x/main.py
  run bash "$pp/main.sh" origin url <<<"$(push_lines refs/heads/topic "$(head_sha)" refs/heads/topic)"
  [ "$status" -eq 0 ]
  [ "$(cat "$CALLS")" = "$(printf 'gate python-lint --changed base=set\ngate secrets-scan --changed base=set')" ]
}

@test "a docs change runs only secrets-scan" {
  change_on_branch docs/a.md
  run bash "$pp/main.sh" origin url <<<"$(push_lines refs/heads/topic "$(head_sha)" refs/heads/topic)"
  [ "$status" -eq 0 ]
  [ "$(cat "$CALLS")" = "gate secrets-scan --changed base=set" ]
}

@test "a push that changes nothing checks nothing" {
  run bash "$pp/main.sh" origin url <<<"$(push_lines refs/heads/main "$(head_sha)" refs/heads/main)"
  [ "$status" -eq 0 ]
  [[ "$output" == *"nothing to check"* ]]
  [ ! -s "$CALLS" ]
}

@test "a red job refuses the push and shows its log" {
  change_on_branch code/bash/a.sh
  FAIL_JOB=bash-lint run bash "$pp/main.sh" origin url <<<"$(push_lines refs/heads/topic "$(head_sha)" refs/heads/topic)"
  [ "$status" -eq 1 ]
  [[ "$output" == *"bash-lint FAILED"* ]]
  [[ "$output" == *"boom from bash-lint"* ]]
}

@test "PRE_PUSH=0 skips every check" {
  change_on_branch code/bash/a.sh
  PRE_PUSH=0 FAIL_JOB=bash-lint run bash "$pp/main.sh" origin url <<<"$(push_lines refs/heads/topic "$(head_sha)" refs/heads/topic)"
  [ "$status" -eq 0 ]
  [[ "$output" == *"PRE_PUSH=0"* ]]
  [ ! -s "$CALLS" ]
}

@test "deletions, tags and land branches are skipped" {
  change_on_branch code/bash/a.sh
  sha="$(head_sha)"
  input="$(printf '(delete) %s refs/heads/old %s\nrefs/tags/v1 %s refs/tags/v1 %s\nrefs/heads/topic %s refs/heads/land/02 %s\n' \
    "$ZERO" "$sha" "$sha" "$ZERO" "$sha" "$ZERO")"
  FAIL_JOB=bash-lint run bash "$pp/main.sh" origin url <<<"$input"
  [ "$status" -eq 0 ]
  [[ "$output" == *"a deletion"* ]]
  [[ "$output" == *"a tag"* ]]
  [[ "$output" == *"landing candidate"* ]]
  [ ! -s "$CALLS" ]
}

@test "--dry-run lists the selected jobs and runs none" {
  change_on_branch code/bash/scripts/x/main.sh
  run bash "$pp/main.sh" --dry-run
  [ "$status" -eq 0 ]
  [[ "$output" == *"secrets-scan would run"* ]]
  [[ "$output" == *"bash-lint would run"* ]]
  [ ! -s "$CALLS" ]
}

@test "--run runs the selected jobs against the base" {
  change_on_branch code/bash/a.sh
  run bash "$pp/main.sh" --run main
  [ "$status" -eq 0 ]
  [[ "$output" == *"bash-lint ok"* ]]
}

@test "the installed hook exits 0 on a clean tree, with and without pushed lines" {
  bash "$pp/main.sh" --install >/dev/null
  cd "$repo"
  run .git/hooks/pre-push origin url </dev/null
  [ "$status" -eq 0 ]
  run .git/hooks/pre-push origin url <<<"$(push_lines refs/heads/main "$(head_sha)" refs/heads/main)"
  [ "$status" -eq 0 ]
  [[ "$output" == *"nothing to check"* ]]
}

@test "the installed hook lets a push go where the checkout has no script" {
  bash "$pp/main.sh" --install >/dev/null
  rm -rf "$pp"
  cd "$repo"
  run .git/hooks/pre-push origin url </dev/null
  [ "$status" -eq 0 ]
}
