#!/usr/bin/env bash
# does: gitleaks over the history reachable from HEAD and the uncommitted changes (--changed: the branch's commits only)
# phase: lint
# timeout: 10
set -euo pipefail
# shellcheck source=SCRIPTDIR/../lib.sh
source "$GATE_DIR/lib.sh"
command -v gitleaks >/dev/null 2>&1 || gate_skip gitleaks "brew install gitleaks"
if git rev-parse --verify --quiet HEAD >/dev/null; then
  range=HEAD
  if [[ "${GATE_CHANGED:-}" == 1 ]] && base="$(gate_base)" && [[ "$(git rev-parse "$base")" != "$(git rev-parse HEAD)" ]]; then
    range="$base..HEAD"
  fi
  gitleaks git --no-banner --redact --log-opts="$range" .
else
  echo "secrets-scan: no commit yet, only the uncommitted changes"
fi
gitleaks git --no-banner --redact --pre-commit .
gitleaks git --no-banner --redact --pre-commit --staged .
