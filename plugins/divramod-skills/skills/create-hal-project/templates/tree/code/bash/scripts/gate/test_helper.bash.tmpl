# shellcheck shell=bash disable=SC2016,SC2034
# Shared by test.bats: a scratch copy of the gate in a scratch repository, fake CLIs on PATH (their bodies are
# single-quoted on purpose: $* and $CALLS expand when the fake runs).

setup() {
  repo="$BATS_TEST_TMPDIR/repo"
  gate="$repo/code/bash/scripts/gate"
  fakes="$BATS_TEST_TMPDIR/fakes"
  CALLS="$BATS_TEST_TMPDIR/calls"
  export CALLS
  mkdir -p "$gate" "$fakes"
  cp -R "$BATS_TEST_DIRNAME/main.sh" "$BATS_TEST_DIRNAME/lib.sh" "$BATS_TEST_DIRNAME/jobs" "$gate/"
  : >"$CALLS"
  unset CI GATE_CHANGED GATE_BASE GATE_ROOT GATE_DIR GATE_SHELLCHECK GATE_PYTHON
  # Only the fakes and the system's own tools: a real gitleaks, shellcheck or bats never runs.
  PATH="$fakes:/usr/bin:/bin"
}

# fake <tool> [exit]: a CLI on PATH that writes `<tool> <args>` to $CALLS and exits with [exit] (0).
fake() {
  printf '#!/bin/sh\necho "%s $*" >>"$CALLS"\nexit %s\n' "$1" "${2:-0}" >"$fakes/$1"
  chmod +x "$fakes/$1"
}

# stub_jobs <name>:<exit>...: replace the scratch gate's jobs with stubs that print their name and exit.
stub_jobs() {
  local spec
  rm -rf "$gate/jobs"
  mkdir -p "$gate/jobs"
  for spec in "$@"; do
    printf '#!/usr/bin/env bash\n# does: stub %s\n# phase: lint\n# timeout: 1\necho "ran %s"\nexit %s\n' \
      "${spec%%:*}" "${spec%%:*}" "${spec#*:}" >"$gate/jobs/${spec%%:*}.sh"
  done
}

# put <file>...: create the files (and their folders) in the scratch repository.
put() {
  local file
  for file in "$@"; do
    mkdir -p "$repo/$(dirname "$file")"
    echo x >"$repo/$file"
  done
}

# git_repo: make the scratch repository a git repository whose main holds everything there is.
git_repo() {
  git -C "$repo" init -q -b main
  commit init
}

# commit <message>: commit the whole scratch repository.
commit() {
  git -C "$repo" add -A
  git -C "$repo" -c user.email=t@t -c user.name=t -c commit.gpgsign=false commit -q --allow-empty -m "$1"
}
