#!/usr/bin/env bash
# gate: the repository's checks, one job file each in jobs/<job>.sh; CI and the hooks run the same jobs.
# Usage: main.sh <job>|all|list [--changed]
set -euo pipefail

gate_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="${GATE_ROOT:-$(cd "$gate_dir/../../../.." && pwd)}"

usage() {
  cat <<'USAGE'
Usage: main.sh <job>|all|list [--changed]
  <job>      run one job (see `list`)
  all        run every job, a summary at the end; exits 1 when any failed
  list       print the jobs with what each does
  --changed  limit the lint and test jobs to the files changed against main
USAGE
}

# header <file> <key>: the value of the job file's `# <key>:` line.
header() {
  sed -n "s/^# $2: *//p" "$1" | head -n 1
}

jobs_list() {
  local file
  for file in "$gate_dir"/jobs/*.sh; do
    [[ -f "$file" ]] || continue
    basename "$file" .sh
  done
}

# run_job <job>: the job from the repo root under its timeout (minutes), when a timeout tool exists.
run_job() {
  local file="$gate_dir/jobs/$1.sh" minutes tool=""
  minutes="$(header "$file" timeout)"
  if [[ "$minutes" =~ ^[0-9]+$ ]]; then
    if command -v timeout >/dev/null 2>&1; then
      tool=timeout
    elif command -v gtimeout >/dev/null 2>&1; then
      tool=gtimeout
    fi
  fi
  if [[ -n "$tool" ]]; then
    (cd "$root" && "$tool" "$((minutes * 60))" bash "$file")
  else
    (cd "$root" && bash "$file")
  fi
}

main() {
  local cmd="" arg job rc failed=0 start
  local -a rows=()
  for arg in "$@"; do
    case "$arg" in
      --changed) export GATE_CHANGED=1 ;;
      -h | --help | help) usage; return 0 ;;
      -*) echo "gate: unknown option $arg" >&2; usage >&2; return 2 ;;
      *)
        if [[ -n "$cmd" ]]; then
          echo "gate: one job at a time ($cmd, $arg)" >&2
          return 2
        fi
        cmd="$arg"
        ;;
    esac
  done
  export GATE_DIR="$gate_dir" GATE_ROOT="$root"
  case "$cmd" in
    "") usage >&2; return 2 ;;
    list)
      for job in $(jobs_list); do
        printf '%-14s %-10s %s\n' "$job" "$(header "$gate_dir/jobs/$job.sh" phase)" \
          "$(header "$gate_dir/jobs/$job.sh" does)"
      done
      ;;
    all)
      for job in $(jobs_list); do
        echo "==> gate $job"
        start=$SECONDS
        rc=0
        run_job "$job" || rc=$?
        if ((rc == 0)); then
          rows+=("ok    $job ($((SECONDS - start))s)")
        else
          rows+=("FAIL  $job ($((SECONDS - start))s, exit $rc)")
          failed=1
        fi
      done
      echo "==> gate summary"
      printf '%s\n' ${rows[@]+"${rows[@]}"}
      return "$failed"
      ;;
    *)
      if [[ ! -f "$gate_dir/jobs/$cmd.sh" ]]; then
        echo "gate: unknown job $cmd (main.sh list)" >&2
        return 2
      fi
      run_job "$cmd"
      ;;
  esac
}

main "$@"
