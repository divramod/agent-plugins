#!/usr/bin/env bash
# pre-push: the light gate checks of only what a push changes, so a push never carries what a laptop catches in
# seconds. Not a pre-commit hook; `git push --no-verify` skips it once, PRE_PUSH=0 always.
#
#   main.sh <remote> <url>     as git's pre-push hook: git's lines `<local ref> <local sha> <remote ref> <remote sha>`
#                              on stdin; each pushed branch head is checked over merge-base(<base>, <sha>)..<sha>
#   main.sh --install          write the hook shim into `git rev-parse --git-path hooks`/pre-push
#   main.sh --dry-run [<base>] the jobs <base>..HEAD selects; runs nothing
#   main.sh --run [<base>]     the jobs <base>..HEAD selects, run without a push
#
# The jobs are the lines of gate/lint-jobs.txt; a job runs when the range changes its paths (bash-* code/bash/,
# python-* code/python/, any other job any file) as `gate/main.sh <job> --changed`.
# Skipped: deletions, tags, pushes to land/*, PRE_PUSH=0. The base: PRE_PUSH_BASE, else origin/main, else main.
# For tests: PRE_PUSH_GATE (the gate script; lint-jobs.txt is read beside it).
# Exit 0 green or skipped, 1 a job failed (or --install met another tool's hook), 2 a usage error.
set -euo pipefail

# git's hook environment sets GIT_DIR (a linked worktree's too): with it set `git rev-parse --show-toplevel` answers
# the folder it runs in, not the checkout. The hook starts at the checkout's top, so ask git afresh.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(git -C "$here" rev-parse --show-toplevel)"
cd "$root"

HOOK_MARK='# Written by code/bash/scripts/pre-push/main.sh --install'
ZERO_SHA='^0+$'

usage() {
  sed -n '2,15p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2
  exit 2
}

gate_script() { echo "${PRE_PUSH_GATE:-$root/code/bash/scripts/gate/main.sh}"; }

hook_text() {
  cat <<EOS
#!/bin/sh
$HOOK_MARK: the light gate checks of what the pushed
# branch changes, by the pushing checkout's own script; a no-op where it has none. 'git push --no-verify' skips it
# once, PRE_PUSH=0 always.
script="\$(git rev-parse --show-toplevel)/code/bash/scripts/pre-push/main.sh"
[ -f "\$script" ] || exit 0
exec bash "\$script" "\$@"
EOS
}

# Writes the hook shim; idempotent; another tool's hook is named and refused (exit 1), never touched.
install_hook() {
  local hooks file
  hooks="$(git rev-parse --git-path hooks)" || return 2
  file="$hooks/pre-push"
  if [[ -f "$file" ]] && [[ "$(cat "$file")" == "$(hook_text)" ]]; then
    echo "$file is current"
    return 0
  fi
  if [[ -f "$file" ]] && ! grep -qF "$HOOK_MARK" "$file"; then
    echo "pre-push: $file is another tool's hook, left alone (call code/bash/scripts/pre-push/main.sh \"\$@\" from it)" >&2
    return 1
  fi
  mkdir -p "$hooks"
  hook_text >"$file"
  chmod 755 "$file"
  echo "wrote $file"
}

# base_rev <sha>: the merge base of the base ref and <sha>; exit 1 when there is no base ref.
base_rev() {
  local ref
  for ref in "${PRE_PUSH_BASE:-}" origin/main main; do
    [[ -n "$ref" ]] || continue
    if git rev-parse --verify --quiet "$ref^{commit}" >/dev/null; then
      git merge-base "$ref" "$1" 2>/dev/null || echo "$ref"
      return 0
    fi
  done
  return 1
}

# push_skip <local ref> <local sha> <remote ref>: prints why the push needs no check (nothing when it needs one).
push_skip() {
  if [[ "$2" =~ $ZERO_SHA ]]; then echo "a deletion"; return 0; fi
  case "$1 $3" in
    refs/tags/* | *' refs/tags/'*) echo "a tag" ;;
    *' refs/heads/land/'*) echo "a landing candidate, the land run gates it" ;;
  esac
}

# job_pattern <job>: the extended regex of the paths that make the job run.
job_pattern() {
  case "$1" in
    bash-*) echo '^code/bash/' ;;
    python-*) echo '^code/python/' ;;
    *) echo '.' ;;
  esac
}

# select_jobs <files>: the lint jobs whose paths <files> (one per line) touch, one per line.
select_jobs() {
  local list job
  list="$(dirname "$(gate_script)")/lint-jobs.txt"
  [[ -f "$list" ]] || return 0
  while IFS= read -r job; do
    job="${job%%#*}"
    job="${job//[[:space:]]/}"
    [[ -n "$job" ]] || continue
    if printf '%s\n' "$1" | grep -Eq "$(job_pattern "$job")"; then echo "$job"; fi
  done <"$list"
}

# check_range <run|dry> <base> <sha>: select the jobs of base..sha and run (or only list) them; exit 1 when one fails.
check_range() {
  local mode=$1 base=$2 sha=$3 files jobs job log start status=0
  files="$(git diff --name-only "$base" "$sha" --)"
  jobs="$(select_jobs "$files")"
  if [[ -z "$jobs" ]]; then
    echo "pre-push: nothing to check (${base:0:12}..${sha:0:12} changes no linted path)"
    return 0
  fi
  while IFS= read -r job; do
    if [[ "$mode" == dry ]]; then
      echo "pre-push: $job would run"
      continue
    fi
    log="$(mktemp)"
    start=$SECONDS
    if GATE_BASE="$base" bash "$(gate_script)" "$job" --changed >"$log" 2>&1; then
      echo "pre-push: $job ok ($((SECONDS - start))s)"
    else
      echo "pre-push: $job FAILED ($((SECONDS - start))s), the log's tail:" >&2
      tail -n 40 "$log" >&2
      status=1
    fi
    rm -f "$log"
  done <<<"$jobs"
  return "$status"
}

# hook: every pushed branch head checked, the first red one refuses the push.
hook() {
  local lref lsha rref rsha why base status=0
  [[ "${PRE_PUSH:-1}" != 0 ]] || { echo "pre-push: PRE_PUSH=0, skipped"; return 0; }
  while read -r lref lsha rref rsha; do
    : "$rsha"
    why="$(push_skip "$lref" "$lsha" "$rref")"
    if [[ -n "$why" ]]; then
      echo "pre-push: $rref skipped ($why)"
      continue
    fi
    base="$(base_rev "$lsha")" || { echo "pre-push: no base (origin/main, main), skipped"; continue; }
    check_range run "$base" "$lsha" || status=1
  done
  return "$status"
}

main() {
  local mode base
  case "${1:-}" in
    --install) install_hook ;;
    --dry-run | --run)
      mode=run
      [[ "$1" == --dry-run ]] && mode=dry
      base="$(base_rev HEAD)" || { echo "pre-push: no base (origin/main, main)" >&2; return 2; }
      [[ -z "${2:-}" ]] || base="$(git merge-base "$2" HEAD)"
      check_range "$mode" "$base" "$(git rev-parse HEAD)"
      ;;
    -h | --help | help) usage ;;
    *) hook ;;
  esac
}

main "$@"
