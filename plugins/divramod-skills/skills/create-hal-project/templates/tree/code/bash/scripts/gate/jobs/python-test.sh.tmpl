#!/usr/bin/env bash
# does: the unittest files (test_*.py) of code/python, one discover per folder (--changed: the changed units')
# phase: test-unit
# timeout: 15
set -euo pipefail
# shellcheck source=SCRIPTDIR/../lib.sh
source "$GATE_DIR/lib.sh"
dirs="$(gate_files code/python -name 'test_*.py' | while IFS= read -r file; do dirname "$file"; done | sort -u)"
if [[ -z "$dirs" ]]; then
  echo "python-test: no test_*.py files"
  exit 0
fi
# GATE_PYTHON names the interpreter (tests put a fake in its place).
python="${GATE_PYTHON:-python3}"
command -v "$python" >/dev/null 2>&1 || gate_skip python3 "brew install python"
status=0
while IFS= read -r dir; do
  echo "python-test: $dir"
  "$python" -m unittest discover -s "$dir" -p 'test_*.py' || status=1
done <<<"$dirs"
exit "$status"
