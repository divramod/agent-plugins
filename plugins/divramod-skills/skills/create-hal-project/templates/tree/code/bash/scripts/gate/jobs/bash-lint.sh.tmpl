#!/usr/bin/env bash
# does: shellcheck over every shell file of code/bash (--changed: the changed units' files)
# phase: lint
# timeout: 5
set -euo pipefail
# shellcheck source=SCRIPTDIR/../lib.sh
source "$GATE_DIR/lib.sh"
files=()
while IFS= read -r file; do
  files+=("$file")
done < <(gate_files code/bash -name '*.sh' -o -name '*.bash')
if ((${#files[@]} == 0)); then
  echo "bash-lint: no shell files"
  exit 0
fi
# GATE_SHELLCHECK names the binary (tests hide a shellcheck that /usr/bin of a CI runner has).
shellcheck="${GATE_SHELLCHECK:-shellcheck}"
command -v "$shellcheck" >/dev/null 2>&1 || gate_skip shellcheck "brew install shellcheck"
"$shellcheck" -x ${files[@]+"${files[@]}"}
echo "bash-lint: ${#files[@]} files clean"
